<?xml version="1.0" encoding="utf-8"?>
<!-- Example for GenisysMaster-Simulator. Copy before editing, then use Open XML. -->
<GenisysMaster version="1" transport="serial">
  <!-- COM1, COM10 and higher are supported. Port access is exclusive.
       Baud must be positive. Genisys requires 8 data bits.
       Parity: N (none), E (even), O (odd). Stop bits: 1 or 2.
       Write timeout includes transmission and driver queue drain (1..600000 ms).
       DTR/RTS select fixed signal levels; hardware/software flow control is off.
       For RS-485, use an adapter with automatic direction control. -->
  <Serial port="COM10" baud-rate="9600" data-bits="8" parity="N" stop-bits="1"
          write-timeout-ms="2000" dtr="false" rts="false" />

  <!-- One transaction at a time on the shared bus; automatic polling is fair
       across IDs. Response timeout must allow device turnaround and the entire
       reply at the chosen baud rate. Controls are never automatically resent. -->
  <Polling enabled="true" secure="true" interval-ms="500"
           response-timeout-ms="1000" retries="2" recovery-interval-ms="2000" />

  <!-- Send one full control frame after every offline-to-online transition. -->
  <Controls flush-on-connect="true" />

  <!-- No IP or UDP port is needed for serial. IDs are unique (1..255).
       Frame size is 1..224 bytes, used for indications and local control drafts.
       All IDs in this list are on the COM port above. -->
  <Slaves>
    <Slave id="34" frame-bytes="125" />
    <!-- Add other IDs hosted by your device/bus, for example:
    <Slave id="35" frame-bytes="125" />
    -->
  </Slaves>
</GenisysMaster>
